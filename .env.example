# moshi — OAuth credentials for the IB service.
#
# Copy this file to `.env` (never commit `.env`) and fill in real values.
# The IB requires ALL SIX variables below to start.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Google — https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:4020/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — Settings > Developer settings > OAuth Apps > New OAuth App
#   Authorization callback URL: http://localhost:4020/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord — Developer Portal > New Application > OAuth2
#   Redirect URL: http://localhost:4020/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
