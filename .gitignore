# Rust build
/target/
**/target/

# Secrets / local config: NEVER commit these
.env
.env.*
# ...but the templates must ship (root .env.example and the playground's
# .env.local.example: both are placeholders, no real credentials).
!*.example
.aws
*.pem
*.key

# Generated TLS certs (regenerated at runtime by tTS)
/certs/

# Service logs
/logs/
*.log

# rq experiment outputs: regenerated by the scripts; keep the scripts, not the data.
# (the out/ dirs are kept via .gitkeep; results and browser profiles are ignored)
rq/**/.profiles/
*.har
rq/**/out/*.json
rq/**/out/*.csv
rq/**/out/*.log
rq/**/out/*.txt
rq/**/out/*.tex

# Generated plots (regenerated by generate_plots.sh)
/plots/
rq/**/out/*.png
rq/**/out/*.pdf

# Node
node_modules/
.next/

# Python
venv/
__pycache__/
*.pyc
.ruff_cache

# IDE / OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
